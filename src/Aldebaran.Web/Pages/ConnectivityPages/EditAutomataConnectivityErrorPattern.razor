@attribute [Authorize(Roles = "Administrador")]
@using Aldebaran.Application.Services.Models;

<LoadingData IsLoadingData="@isLoadingInProgress" />

@if (!isLoadingInProgress)
{
    <RadzenTemplateForm TItem="AutomataConnectivityErrorPattern" Data="@Pattern" Submit="@FormSubmit">
        <RadzenStack>
            <RadzenFormField Text="Patrón de error" Variant="Variant.Text">
                <ChildContent>
                    <RadzenTextBox style="display:block;width:100%" @bind-Value="Pattern.Pattern" Name="Pattern" MaxLength="1000" />
                </ChildContent>
                <Helper>
                    <RadzenRequiredValidator Component="Pattern" Text="El patrón es requerido" />
                </Helper>
            </RadzenFormField>

            <RadzenFormField Text="Destino" Variant="Variant.Text">
                <ChildContent>
                    <RadzenDropDown style="display:block;width:100%" Data="Targets" TextProperty="Text" ValueProperty="Value" @bind-Value="Pattern.Target" Name="Target" />
                </ChildContent>
                <Helper>
                    <RadzenRequiredValidator Component="Target" Text="El destino es requerido" />
                </Helper>
            </RadzenFormField>

            <RadzenFormField Text="Notas" Variant="Variant.Text">
                <ChildContent>
                    <RadzenTextArea style="display:block;width:100%" @bind-Value="Pattern.Notes" Name="Notes" Rows="3" MaxLength="1000" />
                </ChildContent>
            </RadzenFormField>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenCheckBox @bind-Value="Pattern.IsActive" TValue="bool" />
                <label>Activa</label>
            </RadzenStack>
        </RadzenStack>

        <RadzenStack style="margin-top:1rem;" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Submit" Icon="save" Text="Guardar" Variant="Variant.Flat" BusyText="Procesando..." IsBusy="@IsSubmitInProgress" />
            <RadzenButton ButtonStyle="ButtonStyle.Light" Text="Cancelar" Variant="Variant.Flat" Click="@CancelButtonClick" />
        </RadzenStack>
    </RadzenTemplateForm>
}
