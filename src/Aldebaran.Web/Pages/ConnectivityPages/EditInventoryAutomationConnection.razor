@attribute [Authorize(Roles = "Administrador")]
@using Aldebaran.Application.Services.Models;

<LoadingData IsLoadingData="@isLoadingInProgress" />

@if (!isLoadingInProgress)
{
    <RadzenTemplateForm TItem="InventoryAutomationConnection" Data="@Connection" Submit="@FormSubmit">
        <RadzenStack>
            <RadzenFormField Text="Servidor" Variant="Variant.Text">
                <ChildContent>
                    <RadzenTextBox style="display:block;width:100%" @bind-Value="Connection.ServerName" Name="ServerName" />
                </ChildContent>
                <Helper>
                    <RadzenRequiredValidator Component="ServerName" Text="Servidor es requerido" />
                </Helper>
            </RadzenFormField>

            <RadzenFormField Text="Puerto" Variant="Variant.Text">
                <ChildContent>
                    <RadzenTextBox style="display:block;width:100%" @bind-Value="Connection.PortNumber" Name="PortNumber" MaxLength="10" />
                </ChildContent>
            </RadzenFormField>

            <RadzenFormField Text="Base de datos" Variant="Variant.Text">
                <ChildContent>
                    <RadzenTextBox style="display:block;width:100%" @bind-Value="Connection.DatabaseName" Name="DatabaseName" />
                </ChildContent>
                <Helper>
                    <RadzenRequiredValidator Component="DatabaseName" Text="Base de datos es requerida" />
                </Helper>
            </RadzenFormField>

            <RadzenFormField Text="Usuario" Variant="Variant.Text">
                <ChildContent>
                    <RadzenTextBox style="display:block;width:100%" @bind-Value="Connection.UserId" Name="UserId" />
                </ChildContent>
                <Helper>
                    <RadzenRequiredValidator Component="UserId" Text="Usuario es requerido" />
                </Helper>
            </RadzenFormField>

            <RadzenFormField Text="Contraseña" Variant="Variant.Text">
                <ChildContent>
                    <RadzenPassword style="display:block;width:100%" @bind-Value="Connection.Password" Name="Password" />
                </ChildContent>
                <Helper>
                    <RadzenRequiredValidator Component="Password" Text="Contraseña es requerida" />
                </Helper>
            </RadzenFormField>

            <RadzenCheckBox @bind-Value="Connection.Active" TValue="bool" />
            <label class="rz-ml-2">Activa</label>
        </RadzenStack>

        <RadzenStack style="margin-top:1rem;" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Submit" Icon="save" Text="Guardar" Variant="Variant.Flat" BusyText="Procesando..." IsBusy="@IsSubmitInProgress" />
            <RadzenButton ButtonStyle="ButtonStyle.Light" Text="Cancelar" Variant="Variant.Flat" Click="@CancelButtonClick" />
        </RadzenStack>
    </RadzenTemplateForm>
}
