@page "/report/competitor-homologations"
@attribute [Authorize(Roles = "Administrador,Consulta de reportes")]
@inject Aldebaran.Infraestructure.Common.Utils.ISharedStringLocalizer SharedLocalizer
@using Aldebaran.Web.Pages.ReportPages.Item_References.Components
@using Aldebaran.Web.Services.Competitors
@using Aldebaran.Web.Pages.CompetitorPages

<PageTitle>Reporte de homologaciones con la competencia</PageTitle>
<RadzenStack Style="gap:0.3em">
    <RadzenRow AlignItems="AlignItems.Start">
        <RadzenColumn Size="12">
            <RadzenText Text="Reporte de homologaciones con la competencia" TextStyle="TextStyle.H4" TagName="TagName.H1" style="margin: 0" />
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow AlignItems="AlignItems.Start" class="mb-2">
        <RadzenColumn Size="6">
            <div class="rz-text-align-left d-flex gap-3">
                <RadzenButton Variant="Variant.Text" Icon="filter_alt" Click="@OpenFilters" Text="Filtros" ButtonStyle="ButtonStyle.Secondary" class="text-primary-color p-0 pb-1" />
                @if (Filter != null)
                {
                    <RadzenButton Variant="Variant.Text" Click="@RemoveFilters" Text="Limpiar filtros" ButtonStyle="ButtonStyle.Secondary" class="text-decoration-underline p-0 pb-1" />
                }
            </div>
            @if (Filter != null)
            {
                <div class="component-section d-flex flex-column justify-content-start text-secondary-color">
                    <ItemReferencesReportFilterSummaryView Summary="@Filter.Summary" CssClass="pt-2" />
                </div>
            }
        </RadzenColumn>
        <RadzenColumn Size="6" class="align-self-end">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenSplitButton Icon="get_app" Text="Exportar" Click="@ExportAsync" Variant="Variant.Flat" Shade="Shade.Lighter" IsBusy="@IsExporting" Disabled="@(Report?.HasData != true)">
                    <RadzenSplitButtonItem Text="Excel" Value="@ExcelAction" Style="cursor:pointer" />
                </RadzenSplitButton>
                <RadzenSplitButton Icon="build" Text="Acciones" Click="@Save" Variant="Variant.Flat" Shade="Shade.Lighter" IsBusy="@IsBusy" Disabled="Report==null">
                    <RadzenSplitButtonItem Text="Imprimir" Icon="print" Value="print" Style="cursor:pointer" />
                    <RadzenSplitButtonItem Text="Guardar PDF" Icon="picture_as_pdf" Value="save" Style="cursor:pointer" />
                </RadzenSplitButton>
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow AlignItems="AlignItems.Start">
        <RadzenColumn Size="12">
            <RadzenCard style="min-height:600px; overflow-y:auto; position:relative">
                <div id="competitor-homologations-report-container">
                    <div class="report">
                        <table>
                            <tr>
                                <td width="50%">
                                    <h2 class="text-left mb-0">Homologaciones con la competencia</h2>
                                    <span class="mb-1">@DateTime.Now.ToString(SharedLocalizer["datetime:format"])</span>
                                </td>
                                <td width="50%">
                                    @if (Filter != null)
                                    {
                                        <div class="filters">
                                            <div class="title">Filtros:</div>
                                            <ItemReferencesReportFilterSummaryView Summary="@Filter.Summary" ExpandAll="true" />
                                        </div>
                                    }
                                </td>
                            </tr>
                        </table>
                        <div class="mt-1">
                            <LoadingData IsLoadingData="@IsLoadingData" />
                            @if (Report != null)
                            {
                                @if (Report.HasData)
                                {
                                    @foreach (var company in Report.Companies)
                                    {
                                        @* Estilos de corte en línea: print.css (compartido) evita cortar tablas .edged y dejaría páginas en blanco. *@
                                        <table class="edged" style="page-break-inside: auto !important; break-inside: auto !important;">
                                            <thead>
                                                <tr class="border-bottom-1">
                                                    <td width="50%"><span class="bold">Compañía: </span>@company.CompanyName</td>
                                                    <td width="50%"><span class="bold">Sitio web: </span><a href="@company.Website" target="_blank" rel="noopener noreferrer">@company.Website</a></td>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var line in company.Lines)
                                                {
                                                    <tr>
                                                        <td colspan="2" style="padding:0 !important">
                                                            <p class="title" style="padding-left: 1em;">Línea: @line.LineName</p>
                                                        </td>
                                                    </tr>
                                                    @for (int i = 0; i < line.Items.Count; i++)
                                                    {
                                                        var item = line.Items[i];
                                                        <tr class="no-border">
                                                            <td colspan="2" class="no-border" style="padding:0 !important">
                                                                <div style="padding: 1em 1em 0 1em !important; page-break-after: avoid; break-after: avoid;">
                                                                    @if (i > 0)
                                                                    {
                                                                        <hr class="mb-2" />
                                                                    }
                                                                    <h3 class="text-left m-0">@item.ItemName</h3>
                                                                    <p class="m-0">Referencia interna: @item.InternalReference</p>
                                                                </div>
                                                                <div style="margin: 1em;">
                                                                    <table class="striped edged" style="page-break-inside: auto !important; break-inside: auto !important;">
                                                                        <thead>
                                                                            <tr>
                                                                                <th width="12%">Imagen</th>
                                                                                <th width="20%">Referencia PROMOS</th>
                                                                                <th width="15%">Referencia competidor</th>
                                                                                <th width="25%">Producto competidor</th>
                                                                                <th width="13%">Precio (COP)</th>
                                                                                <th width="15%">Enlace</th>
                                                                            </tr>
                                                                        </thead>
                                                                        <tbody>
                                                                            @foreach (var h in item.Homologations)
                                                                            {
                                                                                <tr style="page-break-inside: avoid; break-inside: avoid;">
                                                                                    <td width="12%">
                                                                                        @if (CompetitorImageStorage.Url(h.ImageFileName) is { } url)
                                                                                        {
                                                                                            <img src="@url" alt="@h.CompetitorProductName" title="Click para ampliar" style="max-width:70px; max-height:70px; cursor:pointer; object-fit:contain;" @onclick="@(() => DialogService.OpenCompetitorImage(url, $"[{h.CompetitorReference}] {h.CompetitorProductName}"))" />
                                                                                        }
                                                                                    </td>
                                                                                    <td width="20%">@h.PromosReference</td>
                                                                                    <td width="15%">@h.CompetitorReference</td>
                                                                                    <td width="25%">@h.CompetitorProductName</td>
                                                                                    <td width="13%">@(h.CompetitorPrice?.ToString("N2"))</td>
                                                                                    <td width="15%" style="word-break: break-all;">
                                                                                        @if (!string.IsNullOrWhiteSpace(h.ProductUrl))
                                                                                        {
                                                                                            <a href="@h.ProductUrl" target="_blank" rel="noopener noreferrer">Ver producto</a>
                                                                                        }
                                                                                    </td>
                                                                                </tr>
                                                                            }
                                                                        </tbody>
                                                                    </table>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    }
                                }
                                else
                                {
                                    <div class="no-data-container">
                                        <h4>@SharedLocalizer["report:no-data"]</h4>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="no-data-container">
                                    <h4>@SharedLocalizer["report:unfiltered"]</h4>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>
</RadzenStack>
