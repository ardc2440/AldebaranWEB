@page "/report/minimum-warehouse-stock"
@inject Aldebaran.Infraestructure.Common.Utils.ISharedStringLocalizer SharedLocalizer

<PageTitle>Reporte de referencias con existencia mínima en bodega</PageTitle>
<RadzenStack Style="gap:0.3em">
    <RadzenRow AlignItems="AlignItems.Start">
        <RadzenColumn Size="12">
            <RadzenText Text="Reporte de referencias con existencia mínima en bodega" TextStyle="TextStyle.H4" TagName="TagName.H1" style="margin: 0" />
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow AlignItems="AlignItems.Start" class="mb-2">
        <RadzenColumn Size="6">
            <div class="rz-text-align-left d-flex gap-3">
                <RadzenButton Variant="Variant.Text" Icon="filter_alt" Click="@OpenFilters" Text="Filtros" ButtonStyle="ButtonStyle.Secondary" class="text-primary-color p-0 pb-1" />
                @if (Filter != null)
                {
                    <RadzenButton Variant="Variant.Text" Click="@RemoveFilters" Text="Limpiar filtros" ButtonStyle="ButtonStyle.Secondary" class="text-decoration-underline p-0 pb-1" />
                }
            </div>
            <div class="component-section d-flex flex-column justify-content-start text-secondary-color">
                @if (Filter != null)
                {
                    @if (Filter.UmbralMaximoExistencias.HasValue)
                    {
                        <div class="d-flex flex-row justify-content-start gap-1 component-section-item">
                            <p class="component-label m-0 fw-bold">Umbral máximo de existencias: </p>
                            <span style="line-height: 1rem;transform: translate(0, -2px);">@Filter.UmbralMaximoExistencias.Value.ToString("N0")</span>
                        </div>
                    }
                    @if (Filter.Warehouse != null)
                    {
                        <div class="d-flex flex-row justify-content-start gap-1 component-section-item">
                            <p class="component-label m-0 fw-bold">Bodega: </p>
                            <span style="line-height: 1rem;transform: translate(0, -2px);">@Filter.Warehouse.WarehouseName</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Filter.ItemIds) && Filter.SelectedItems?.Any() == true)
                    {
                        <div class="d-flex flex-row justify-content-start gap-1 component-section-item">
                            <p class="component-label m-0 fw-bold">Artículos: </p>
                            <span style="line-height: 1rem;transform: translate(0, -2px);">
                                @if (Filter.SelectedItems.Count <= 2)
                                {
                                    @string.Join(", ", Filter.SelectedItems.Select(i => i.ItemName))
                                }
                                else
                                {
                                    @($"{Filter.SelectedItems.Count} artículos seleccionados")
                                }
                            </span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Filter.ProviderItemName))
                    {
                        <div class="d-flex flex-row justify-content-start gap-1 component-section-item">
                            <p class="component-label m-0 fw-bold">Artículo del proveedor: </p>
                            <span style="line-height: 1rem;transform: translate(0, -2px);">@Filter.ProviderItemName</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Filter.ProviderReference))
                    {
                        <div class="d-flex flex-row justify-content-start gap-1 component-section-item">
                            <p class="component-label m-0 fw-bold">Referencia interna del proveedor: </p>
                            <span style="line-height: 1rem;transform: translate(0, -2px);">@Filter.ProviderReference</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Filter.ProviderReferenceName))
                    {
                        <div class="d-flex flex-row justify-content-start gap-1 component-section-item">
                            <p class="component-label m-0 fw-bold">Referencia del proveedor: </p>
                            <span style="line-height: 1rem;transform: translate(0, -2px);">@Filter.ProviderReferenceName</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Filter.ProviderReferenceCode))
                    {
                        <div class="d-flex flex-row justify-content-start gap-1 component-section-item">
                            <p class="component-label m-0 fw-bold">Código de referencia del proveedor: </p>
                            <span style="line-height: 1rem;transform: translate(0, -2px);">@Filter.ProviderReferenceCode</span>
                        </div>
                    }
                    @if (Filter.ItemIsActive.HasValue)
                    {
                        <div class="d-flex flex-row justify-content-start gap-1 component-section-item">
                            <p class="component-label m-0 fw-bold">Artículos activos: </p>
                            <span style="line-height: 1rem;transform: translate(0, -2px);">@(Filter.ItemIsActive.Value ? "Sí" : "No")</span>
                        </div>
                    }
                    @if (Filter.ItemIsDomesticProduct.HasValue)
                    {
                        <div class="d-flex flex-row justify-content-start gap-1 component-section-item">
                            <p class="component-label m-0 fw-bold">Producto nacional: </p>
                            <span style="line-height: 1rem;transform: translate(0, -2px);">@(Filter.ItemIsDomesticProduct.Value ? "Sí" : "No")</span>
                        </div>
                    }
                    @if (Filter.ItemIsSpecialImport.HasValue)
                    {
                        <div class="d-flex flex-row justify-content-start gap-1 component-section-item">
                            <p class="component-label m-0 fw-bold">Importado especial: </p>
                            <span style="line-height: 1rem;transform: translate(0, -2px);">@(Filter.ItemIsSpecialImport.Value ? "Sí" : "No")</span>
                        </div>
                    }
                    @if (Filter.ItemIsSaleOff.HasValue)
                    {
                        <div class="d-flex flex-row justify-content-start gap-1 component-section-item">
                            <p class="component-label m-0 fw-bold">En oferta: </p>
                            <span style="line-height: 1rem;transform: translate(0, -2px);">@(Filter.ItemIsSaleOff.Value ? "Sí" : "No")</span>
                        </div>
                    }
                    @if (Filter.ItemIsCatalogVisible.HasValue)
                    {
                        <div class="d-flex flex-row justify-content-start gap-1 component-section-item">
                            <p class="component-label m-0 fw-bold">Visible en catálogo: </p>
                            <span style="line-height: 1rem;transform: translate(0, -2px);">@(Filter.ItemIsCatalogVisible.Value ? "Sí" : "No")</span>
                        </div>
                    }
                    @if (Filter.ReferenceIsActive.HasValue)
                    {
                        <div class="d-flex flex-row justify-content-start gap-1 component-section-item">
                            <p class="component-label m-0 fw-bold">Referencias activas: </p>
                            <span style="line-height: 1rem;transform: translate(0, -2px);">@(Filter.ReferenceIsActive.Value ? "Sí" : "No")</span>
                        </div>
                    }
                    @if (Filter.ReferenceHasAlarmMinimumQuantity.HasValue)
                    {
                        <div class="d-flex flex-row justify-content-start gap-1 component-section-item">
                            <p class="component-label m-0 fw-bold">Con alarma de cantidad mínima: </p>
                            <span style="line-height: 1rem;transform: translate(0, -2px);">@(Filter.ReferenceHasAlarmMinimumQuantity.Value ? "Sí" : "No")</span>
                        </div>
                    }
                    @if (Filter.ReferenceIsSoldOut.HasValue)
                    {
                        <div class="d-flex flex-row justify-content-start gap-1 component-section-item">
                            <p class="component-label m-0 fw-bold">Agotado: </p>
                            <span style="line-height: 1rem;transform: translate(0, -2px);">@(Filter.ReferenceIsSoldOut.Value ? "Sí" : "No")</span>
                        </div>
                    }
                    <div class="component-section d-flex flex-column justify-content-start pt-2">
                        @if (Filter.ItemReferences.Any())
                        {
                            <p class="component-label m-0 fw-bold">Referencias: </p>
                            @for (int i = 0; i < Filter.ItemReferences.Count(); i++)
                            {
                                <span class="@(i>=2 ? "read-more" : "")" style="@(i>=2 ? "display: none" : "")">(@Filter.ItemReferences[i].Item.Line.LineName) @Filter.ItemReferences[i].Item.ItemName - @Filter.ItemReferences[i].ReferenceName</span>
                            }
                            @if (Filter.ItemReferences.Count() > 2)
                            {
                                <div>
                                    <a href="javascript:;" id="toggleLink" @onclick="ToggleReadMore">Ver más</a>
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        </RadzenColumn>
        <RadzenColumn Size="6" class="align-self-end">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenSplitButton Icon="build" Text="Acciones" Click="@Save" Variant="Variant.Flat" Shade="Shade.Lighter" IsBusy="@IsBusy" Disabled="ViewModel==null">
                    <RadzenSplitButtonItem Text="Imprimir" Icon="print" Value="print" Style="cursor:pointer" />
                    <RadzenSplitButtonItem Text="Guardar PDF" Icon="picture_as_pdf" Value="save" Style="cursor:pointer" />
                </RadzenSplitButton>
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow AlignItems="AlignItems.Start">
        <RadzenColumn Size="12">
            <RadzenCard style="min-height:600px; overflow-y:auto; position:relative">
                <div id="minimum-warehouse-stock-report-container">
                    <div class="report">
                        <table>
                            <tr>
                                <td width="50%">
                                    <h2 class="text-left mb-0">Referencias con existencia mínima en bodega</h2>
                                    <span class="mb-1">@DateTime.Now.ToString(SharedLocalizer["datetime:format"])</span>
                                </td>
                                <td width="50%">
                                    @if (Filter != null)
                                    {
                                        <div class="filters">
                                            <div class="title">Filtros:</div>
                                            <div>
                                                @if (Filter.UmbralMaximoExistencias.HasValue)
                                                {
                                                    <div style="display:flex; gap:5px; flex-direction:row; justify-content:end">
                                                        <div class="type">Umbral máximo de existencias: </div>
                                                        <span>@Filter.UmbralMaximoExistencias.Value.ToString("N0")</span>
                                                    </div>
                                                }
                                                @if (Filter.Warehouse != null)
                                                {
                                                    <div style="display:flex; gap:5px; flex-direction:row; justify-content:end">
                                                        <div class="type">Bodega: </div>
                                                        <span>@Filter.Warehouse.WarehouseName</span>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(Filter.ItemIds) && Filter.SelectedItems?.Any() == true)
                                                {
                                                    <div style="display:flex; gap:5px; flex-direction:row; justify-content:end">
                                                        <div class="type">Artículos: </div>
                                                        <span>
                                                            @if (Filter.SelectedItems.Count <= 2)
                                                            {
                                                                @string.Join(", ", Filter.SelectedItems.Select(i => i.ItemName))
                                                            }
                                                            else
                                                            {
                                                                @($"{Filter.SelectedItems.Count} artículos")
                                                            }
                                                        </span>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(Filter.ProviderItemName))
                                                {
                                                    <div style="display:flex; gap:5px; flex-direction:row; justify-content:end">
                                                        <div class="type">Artículo del proveedor: </div>
                                                        <span>@Filter.ProviderItemName</span>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(Filter.ProviderReference))
                                                {
                                                    <div style="display:flex; gap:5px; flex-direction:row; justify-content:end">
                                                        <div class="type">Referencia interna del proveedor: </div>
                                                        <span>@Filter.ProviderReference</span>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(Filter.ProviderReferenceName))
                                                {
                                                    <div style="display:flex; gap:5px; flex-direction:row; justify-content:end">
                                                        <div class="type">Referencia del proveedor: </div>
                                                        <span>@Filter.ProviderReferenceName</span>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(Filter.ProviderReferenceCode))
                                                {
                                                    <div style="display:flex; gap:5px; flex-direction:row; justify-content:end">
                                                        <div class="type">Código de referencia del proveedor: </div>
                                                        <span>@Filter.ProviderReferenceCode</span>
                                                    </div>
                                                }
                                                @if (Filter.ItemIsActive.HasValue)
                                                {
                                                    <div style="display:flex; gap:5px; flex-direction:row; justify-content:end">
                                                        <div class="type">Artículos activos: </div>
                                                        <span>@(Filter.ItemIsActive.Value ? "Sí" : "No")</span>
                                                    </div>
                                                }
                                                @if (Filter.ItemIsDomesticProduct.HasValue)
                                                {
                                                    <div style="display:flex; gap:5px; flex-direction:row; justify-content:end">
                                                        <div class="type">Producto nacional: </div>
                                                        <span>@(Filter.ItemIsDomesticProduct.Value ? "Sí" : "No")</span>
                                                    </div>
                                                }
                                                @if (Filter.ItemIsSpecialImport.HasValue)
                                                {
                                                    <div style="display:flex; gap:5px; flex-direction:row; justify-content:end">
                                                        <div class="type">Importado especial: </div>
                                                        <span>@(Filter.ItemIsSpecialImport.Value ? "Sí" : "No")</span>
                                                    </div>
                                                }
                                                @if (Filter.ItemIsSaleOff.HasValue)
                                                {
                                                    <div style="display:flex; gap:5px; flex-direction:row; justify-content:end">
                                                        <div class="type">En oferta: </div>
                                                        <span>@(Filter.ItemIsSaleOff.Value ? "Sí" : "No")</span>
                                                    </div>
                                                }
                                                @if (Filter.ItemIsCatalogVisible.HasValue)
                                                {
                                                    <div style="display:flex; gap:5px; flex-direction:row; justify-content:end">
                                                        <div class="type">Visible en catálogo: </div>
                                                        <span>@(Filter.ItemIsCatalogVisible.Value ? "Sí" : "No")</span>
                                                    </div>
                                                }
                                                @if (Filter.ReferenceIsActive.HasValue)
                                                {
                                                    <div style="display:flex; gap:5px; flex-direction:row; justify-content:end">
                                                        <div class="type">Referencias activas: </div>
                                                        <span>@(Filter.ReferenceIsActive.Value ? "Sí" : "No")</span>
                                                    </div>
                                                }
                                                @if (Filter.ReferenceHasAlarmMinimumQuantity.HasValue)
                                                {
                                                    <div style="display:flex; gap:5px; flex-direction:row; justify-content:end">
                                                        <div class="type">Con alarma de cantidad mínima: </div>
                                                        <span>@(Filter.ReferenceHasAlarmMinimumQuantity.Value ? "Sí" : "No")</span>
                                                    </div>
                                                }
                                                @if (Filter.ReferenceIsSoldOut.HasValue)
                                                {
                                                    <div style="display:flex; gap:5px; flex-direction:row; justify-content:end">
                                                        <div class="type">Agotado: </div>
                                                        <span>@(Filter.ReferenceIsSoldOut.Value ? "Sí" : "No")</span>
                                                    </div>
                                                }
                                                @if (Filter.ItemReferences.Any())
                                                {
                                                    <div style="display:flex; flex-direction:column; justify-content:end">
                                                        <div class="type">Referencias: </div>
                                                        @for (int i = 0; i < Filter.ItemReferences.Count(); i++)
                                                        {
                                                            <p class="@(i>=2 ? "read-more-page" : "")" style="@(i>=2 ? "display: none" : "")">(@Filter.ItemReferences[i].Item.Line.LineName) @Filter.ItemReferences[i].Item.ItemName - @Filter.ItemReferences[i].ReferenceName</p>
                                                        }
                                                        @if (Filter.ItemReferences.Count() > 2)
                                                        {
                                                            <div>
                                                                <a href="javascript:;" id="toggleLinkPage" @onclick="ToggleReadMorePage">Ver más</a>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </td>
                            </tr>
                        </table>
                        <div class="mt-1 border">
                            <LoadingData IsLoadingData="@IsLoadingData" />
                            @if (HasReportData())
                            {
                                @foreach (var lineGroup in GetItemsByLine())
                                {
                                    <table class="edged">
                                        <tbody>
                                            <tr>
                                                <td width="100%" style="padding:0 !important">
                                                    <p class="title">@lineGroup.Key</p>
                                                </td>
                                            </tr>
                                            @for (int i = 0; i < lineGroup.Count(); i++)
                                            {
                                                var item = lineGroup.ElementAt(i);
                                                <tr>
                                                    <td width="100%" style="padding:0 !important">
                                                        <div style="padding: 1em 1em 0 1em !important;">
                                                            @if (i > 0)
                                                            {
                                                                <hr class="mb-2" />
                                                            }
                                                            <h3 title="Click para ver imagen" @onclick="@(args => ShowImageDialog($"[{item.InternalReference}] {item.ItemName}"))"
                                                                style="cursor: pointer;"
                                                                class="text-left m-0">
                                                                @item.ItemName
                                                            </h3>
                                                            <p class="m-0">
                                                                Referencia interna: @item.InternalReference
                                                            </p>
                                                        </div>
                                                        <div style="margin: 1em;">
                                                            <table class="striped edged">
                                                                <thead>
                                                                    <tr>
                                                                        <th width="25%">Referencia</th>
                                                                        <th width="15%">Código</th>
                                                                        <th width="10%">Total Físico</th>
                                                                        <th width="10%">Comprometido</th>
                                                                        <th width="10%">Disponible</th>
                                                                        @foreach (var warehouse in GetUniqueWarehouses())
                                                                        {
                                                                            <th>@warehouse.WarehouseName</th>
                                                                        }
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var reference in item.References)
                                                                    {
                                                                        <tr>
                                                                            <td width="25%"><strong>@reference.ReferenceName</strong></td>
                                                                            <td width="15%">@reference.ReferenceCode</td>
                                                                            <td width="10%" class="text-right">@reference.TotalPhysicalStock.ToString("N0")</td>
                                                                            <td width="10%" class="text-right">@reference.CommittedQuantity.ToString("N0")</td>
                                                                            <td width="10%" class="text-right">@reference.AvailableQuantity.ToString("N0")</td>
                                                                            @foreach (var warehouse in GetUniqueWarehouses())
                                                                            {
                                                                                <td class="text-right">
                                                                                    @GetWarehouseStockForReference(reference, warehouse.WarehouseId)
                                                                                </td>
                                                                            }
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                            }
                            else if (Filter != null)
                            {
                                <div class="no-data-container">
                                    <h4>@SharedLocalizer["report:no-data"]</h4>
                                </div>
                            }
                            else
                            {
                                <div class="no-data-container">
                                    <h4>@SharedLocalizer["report:unfiltered"]</h4>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>
</RadzenStack>