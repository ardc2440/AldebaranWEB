@page "/track_log"
@attribute [Authorize(Roles = "Administrador,Log del sistema")]
@using Aldebaran.Web.Resources.LocalizedControls;
@using Aldebaran.Application.Services.Models.TrackLogs;
@inject Aldebaran.Infraestructure.Common.Utils.ISharedStringLocalizer SharedLocalizer;

<PageTitle>Track</PageTitle>

<RadzenStack>
    <RadzenRow AlignItems="AlignItems.Center">
        <RadzenColumn Size="12">
            <RadzenText Text="Track" TextStyle="TextStyle.H4" TagName="TagName.H1" style="margin: 0" />
        </RadzenColumn>
    </RadzenRow>
    <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Info" Visible="@(!string.IsNullOrEmpty(infoMessage))" AllowClose="false">
        @infoMessage
    </RadzenAlert>
    <RadzenRow AlignItems="AlignItems.End" Gap="1rem">
        <RadzenColumn SizeMD="2">
            <RadzenFormField Text="Buscar por" Variant="Variant.Text" Style="width: 100%;">
                <RadzenDropDown Data="@objectTypes" TextProperty="Name" ValueProperty="ObjectType" TValue="byte?" AllowClear="true"
                                @bind-Value="@selectedObjectType" Change="@(async _ => await ObjectTypeChangedAsync())" style="display: block; width: 100%" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn SizeMD="2">
            <RadzenFormField Text="@ObjectSearchTitle" Variant="Variant.Text" Style="width: 100%;">
                <RadzenTextBox @bind-Value="@objectSearchText" Change="@(async _ => await SearchObjectsAsync())" Disabled="@(selectedObjectType == null)" style="display: block; width: 100%" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn SizeMD="3">
            <RadzenFormField Text="@ObjectFieldTitle" Variant="Variant.Text" Style="width: 100%;">
                <RadzenDropDown Data="@objectOptions" TextProperty="Description" ValueProperty="ObjectId" TValue="int?" AllowClear="true"
                                AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Disabled="@(!objectOptions.Any())"
                                @bind-Value="@selectedObjectId" Change="@(async _ => await ApplyFiltersAsync())" style="display: block; width: 100%" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn SizeMD="2">
            <RadzenFormField Text="@EntityFieldTitle" Variant="Variant.Text" Style="width: 100%;">
                <RadzenDropDown Data="@entities" TextProperty="DisplayName" ValueProperty="Name" TValue="string" AllowClear="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                @bind-Value="@selectedEntity" Change="@(async _ => await ApplyFiltersAsync())" style="display: block; width: 100%" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn SizeMD="3">
            <RadzenRow Gap="0.5rem">
                <RadzenColumn Size="6">
                    <RadzenFormField Text="Desde" Variant="Variant.Text" Style="width: 100%;">
                        <RadzenDatePicker TValue="DateTime?" DateFormat="@SharedLocalizer["date:format"]" @bind-Value="@dateFrom" Change="@(async _ => await ApplyFiltersAsync())" style="display: block; width: 100%" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenFormField Text="Hasta" Variant="Variant.Text" Style="width: 100%;">
                        <RadzenDatePicker TValue="DateTime?" DateFormat="@SharedLocalizer["date:format"]" @bind-Value="@dateTo" Change="@(async _ => await ApplyFiltersAsync())" style="display: block; width: 100%" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow AlignItems="AlignItems.End" Gap="1rem">
        <RadzenColumn SizeMD="2">
            <RadzenFormField Text="Acción" Variant="Variant.Text" Style="width: 100%;">
                <RadzenDropDown Data="@actions" TextProperty="Text" ValueProperty="Value" TValue="TrackAction?" AllowClear="true" @bind-Value="@selectedAction" Change="@(async _ => await ApplyFiltersAsync())" style="display: block; width: 100%" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn SizeMD="3">
            <RadzenFormField Text="Usuario que hizo el cambio" Variant="Variant.Text" Style="width: 100%;">
                <RadzenTextBox @bind-Value="@modifierName" Change="@(async _ => await ApplyFiltersAsync())" style="display: block; width: 100%" />
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow>
        <RadzenColumn SizeMD="12">
            <LocalizedDataGrid @ref="entriesGrid" Count="@count" LoadData="@LoadData" Data="@entries" TItem="TrackEntry" IsLoading="@isLoading"
                               AllowPaging="true" ShowPagingSummary="true" PageSize="20" PageSizeOptions=@(new int[]{10, 20, 30, 50}) AllowColumnResize="true"
                               RowSelect="@(async (TrackEntry e) => await ShowDetailAsync(e))" SelectionMode="DataGridSelectionMode.Single">
                <Columns>
                    <RadzenDataGridColumn TItem="TrackEntry" Property="ModifiedDate" Title="Fecha" Width="15%">
                        <Template Context="e"><span>@e.ModifiedDate.ToString(SharedLocalizer["datetime:format"])</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="TrackEntry" Property="EntityDisplayName" Title="Entidad" Width="22%" />
                    <RadzenDataGridColumn TItem="TrackEntry" Property="Action" Title="Acción" Width="11%">
                        <Template Context="e"><span>@ActionText(e.Action)</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="TrackEntry" Property="EntityKey" Title="Registro" Width="37%" />
                    <RadzenDataGridColumn TItem="TrackEntry" Property="ModifierName" Title="Usuario" Width="15%" />
                </Columns>
            </LocalizedDataGrid>
        </RadzenColumn>
    </RadzenRow>
</RadzenStack>
