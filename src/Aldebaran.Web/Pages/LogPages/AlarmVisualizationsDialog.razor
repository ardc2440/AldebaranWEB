@using Aldebaran.Web.Resources.LocalizedControls;
@using Aldebaran.Application.Services.Models.AlarmLogs;
@inject Aldebaran.Infraestructure.Common.Utils.ISharedStringLocalizer SharedLocalizer;

<RadzenStack>
    <RadzenText TextStyle="TextStyle.Subtitle1">@Alarm?.Document</RadzenText>
    <RadzenText TextStyle="TextStyle.Body2">@Alarm?.Description</RadzenText>
    <LocalizedDataGrid Data="@visualizations" TItem="AlarmVisualization" IsLoading="@isLoading" AllowPaging="true" PageSize="10" AllowSorting="true" AllowColumnResize="true">
        <Columns>
            <RadzenDataGridColumn TItem="AlarmVisualization" Property="EmployeeName" Title="Usuario" Width="40%" />
            <RadzenDataGridColumn TItem="AlarmVisualization" Property="AreaName" Title="Área" Width="30%" />
            <RadzenDataGridColumn TItem="AlarmVisualization" Property="VisualizedDate" Title="Fecha de visualización" Width="30%">
                <Template Context="visualization">
                    <span>@visualization.VisualizedDate.ToString(SharedLocalizer["date:format"])</span>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </LocalizedDataGrid>
</RadzenStack>
