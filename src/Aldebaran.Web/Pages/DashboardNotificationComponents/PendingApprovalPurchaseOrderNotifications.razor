@using Aldebaran.Web.Resources.LocalizedControls;
@using Aldebaran.Application.Services.Models;

@inject Aldebaran.Infraestructure.Common.Utils.ISharedStringLocalizer SharedLocalizer ;

<RadzenCard class="rz-col-12" Style="max-width: 100%">
    <NotificationTitle DataUpdate="@GridData_Update" GridTimer="@GridTimer" Title="Aprobacion de ajustes en ordenes de compra" Timers="@Timers" />
    <RadzenCard Variant="Radzen.Variant.Text" class="px-0">
        <RadzenRow class="rz-m-1">
            <RadzenTextBox Placeholder="Buscar ..." style="display: block; width: 100%" @oninput="@Search" />
        </RadzenRow>
        <RadzenRow class="rz-m-1">
            <LocalizedDataGrid CellRender="@CellRender" Style="height: 100%" PageSize="@pageSize" @ref="pendingApprovalPurchaseOrdersGrid" AllowFiltering="true" 
                               AllowPaging="true" AllowSorting="true" ShowPagingSummary="true" Data="@pendingApprovalPurchaseOrders" TItem="PurchaseOrder" 
                               IsLoading="@(GridTimer.IsLoading||isLoadingInProgress)">
                <Columns>
                    <RadzenDataGridColumn TItem="PurchaseOrder" Property="OrderNumber" Title="Número de orden" Width="65%" />
                    <RadzenDataGridColumn TItem="PurchaseOrder" Property="ExpectedReceiptDate" Title="Fecha est. recibo" Width="70%">
                        <Template Context="purchasOrder">
                            <span>@purchasOrder.ExpectedReceiptDate.ToString(SharedLocalizer["date:format"])</span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PurchaseOrder" Title="Dias restantes" Width="60%">
                        <Template Context="purchasOrder">
                            @{
                                var days = (int)(@purchasOrder.ExpectedReceiptDate - System.DateTime.Today).Days;
                            }
                            <span>@days dias</span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PurchaseOrder" Property="Provider.ProviderName" Title="Proveedor" Width="80%"></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PurchaseOrder" Property="ShipmentForwarderAgentMethod.ForwarderAgent.Forwarder.ForwarderName" Title="Transportadora" Width="80%"></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PurchaseOrder" Property="ShipmentForwarderAgentMethod.ForwarderAgent.ForwarderAgentName" Title="Agente" Width="80%"></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PurchaseOrder" Property="ShipmentForwarderAgentMethod.ShipmentMethod.ShipmentMethodName" Title="Método de envio" Width="80%"></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PurchaseOrder" Title="Gestión" Width="120px" Filterable="false" Sortable="false" TextAlign="TextAlign.Center">
                        <Template Context="purchaseOrder">
                            <RadzenButton Icon="approval" Tooltip="Aprobar o devolver Orden de Compra" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Click="@(args => OpenPurchaseOrderApproval(purchaseOrder))"/>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>                
            </LocalizedDataGrid>
        </RadzenRow>
    </RadzenCard>
</RadzenCard>
