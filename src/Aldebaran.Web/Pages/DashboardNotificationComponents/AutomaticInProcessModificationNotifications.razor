@using Aldebaran.Application.Services.Models;
@using Aldebaran.Web.Resources.LocalizedControls;
@using Aldebaran.Web.Utils;
@inject Aldebaran.Infraestructure.Common.Utils.ISharedStringLocalizer SharedLocalizer ;
@inherits Aldebaran.Web.Pages.DashboardNotificationComponents.AutomaticInProcessModificationNotificationsBase

<RadzenCard class="rz-col-12" Style="max-width: 100%">
    <NotificationTitle DataUpdate="@GridData_Update" GridTimer="@GridTimer" Title="Modificaciones automáticas de traslados a proceso" Timers="@Timers" />
    <RadzenCard Variant="Radzen.Variant.Text" class="px-0">
        <RadzenRow class="rz-m-1">
            <RadzenTextBox Placeholder="Buscar ..." style="display: block; width: 100%" @oninput="@Search" />
        </RadzenRow>
        <RadzenRow class="rz-m-1">
            <LocalizedDataGrid AllowRowSelectOnRowClick="false" @ref="modificationsGrid" TItem="AutomaticCustomerOrderInProcessModification" 
                              Data="@modifications" PageSize="@pageSize" 
                              AllowPaging="true" AllowSorting="true" ShowPagingSummary="true" 
                              AllowFiltering="true" Page="OnPageChanged"
                              IsLoading="@(isLoadingInProgress||GridTimer.IsLoading)"
                              SelectionMode="DataGridSelectionMode.Multiple" @bind-Value=@selectedModifications>
                <Columns>
                    <RadzenDataGridColumn TItem="AutomaticCustomerOrderInProcessModification" Width="40px" Sortable="false" Filterable="false">
                        <HeaderTemplate>
                            <RadzenCheckBox TabIndex="-1" TriState="false" TValue="bool?" InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "Select all items" }})"
                                            Value="@(IsAllPageSelected().Result ? true : (selectedModifications?.Any() ?? false ? null : false))"       
                                            Change="@(args => SelectAllItems((bool)args))"
                                            MouseEnter="@(args => ShowTooltip(args,"Marcar toda la página", new TooltipOptions(){ Position = TooltipPosition.Left }))" />
                        </HeaderTemplate>
                        <Template Context="data">
                            <RadzenCheckBox TabIndex="-1" TriState="false" Value="@(selectedModifications != null && selectedModifications.Contains(data))" InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "Select item" }})"
                                            TValue="bool" 
                                            Change="@(args => ToggleSelection(data, args))"
                                            MouseEnter="@(args => ShowTooltip(args,"Marcar", new TooltipOptions(){ Position = TooltipPosition.Left }))" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="AutomaticCustomerOrderInProcessModification" Property="Order_Number" Title="No. Pedido" Width="150px">
                        <Template Context="modification">
                            <RadzenLink href="javascript:void(0);" @onclick="@(async (args) => await ShowOrderInfo(modification.Order_Number))">
                                @modification.Order_Number
                            </RadzenLink>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="AutomaticCustomerOrderInProcessModification" Property="Customer_Name" Title="Cliente" Width="200px" />
                    <RadzenDataGridColumn TItem="AutomaticCustomerOrderInProcessModification" Property="ActionType" Title="Tipo de Acción" Width="150px"/>                    
                    <RadzenDataGridColumn TItem="AutomaticCustomerOrderInProcessModification" Property="ActionDate" Title="Fecha de Acción" Width="180px">
                        <Template Context="modification">
                            @modification.ActionDate.ToString(SharedLocalizer["datetime:format"])
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="AutomaticCustomerOrderInProcessModification" Property="ActionReason" Title="Razón de la Acción" Width="250px" />
                    <RadzenDataGridColumn TItem="AutomaticCustomerOrderInProcessModification" Property="EmployeeName" Title="Empleado" Width="200px" />
                    <RadzenDataGridColumn TItem="AutomaticCustomerOrderInProcessModification" Filterable="false" Sortable="false" Width="50px" TextAlign="TextAlign.Center" Pickable="false" Reorderable="false" Resizable="false">
                        <Template Context="modification">
                            <RadzenButton Icon="assignment_turned_in" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@(args => DisableModifications(modification))" @onclick:stopPropagation="true" MouseEnter="@(args => ShowTooltip(args, "Ocultar modificación", new TooltipOptions() { Position = TooltipPosition.Left }))" />
                        </Template>
                    </RadzenDataGridColumn>                    
                </Columns>
            </LocalizedDataGrid>
        </RadzenRow>
    </RadzenCard>
</RadzenCard>